# Application
NODE_ENV=development
PORT=3000

# Database: MySQL 8 (locally from AMPPS, see README)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DATABASE=eventor_admin
# Used by the e2e tests
DB_DATABASE_TEST=eventor_admin_test

# HTTP
# "*" reflects any origin; otherwise a comma-separated allowlist (credentials allowed)
CORS_ORIGINS=http://localhost:3001
SWAGGER_ENABLED=true
LOG_REQUESTS=true
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000
# Per-route-group limits (src/common/http/throttles.ts): auth and public forms,
# multipart uploads, and the admin routes that email a third party.
AUTH_THROTTLE_LIMIT=10
UPLOAD_THROTTLE_LIMIT=30
MAIL_THROTTLE_LIMIT=20
# Max JSON / urlencoded body; multipart uploads are capped per route.
BODY_LIMIT=1mb

# Public URLs (domains not chosen yet)
API_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
APP_PUBLIC_URL=http://localhost:3001

# Auth: random, >= 32 chars in production
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=900

# Files: STORAGE_ROOT must be outside the web root
STORAGE_ROOT=./storage
FILES_SIGNING_SECRET=change-me-to-another-long-random-string
FILES_URL_TTL=900

# Queue: redis://127.0.0.1:6379 for BullMQ; empty runs jobs in-process
REDIS_URL=

# Mail (Google Workspace SMTP relay); empty SMTP_HOST logs mails to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Eventor <no-reply@eventor.dz>

# Push (FCM HTTP v1). Empty FCM_CREDENTIALS_PATH = pushes are only logged.
# Key: Firebase console → Project settings → Service accounts → Generate new private key.
# FCM_PROJECT_ID is optional (defaults to the key's project_id).
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# First admin, created by the SeedV1 migration (skipped when empty)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
